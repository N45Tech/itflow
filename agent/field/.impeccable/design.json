  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Text-led action with the shared touch target, hover, focus, and disabled treatments.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Confirm onsite</button>",
      "css": ".ds-button-primary{font-family:\"Segoe UI\",system-ui,sans-serif;font-size:1rem;font-weight:650;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:11px 18px;border:1px solid transparent;border-radius:9px;cursor:pointer;text-decoration:none;touch-action:manipulation;background:var(--action,#126e61);color:var(--surface,#fffdf8);}.ds-button-primary:hover{filter:brightness(.92)}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#087b6b);outline-offset:3px}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
