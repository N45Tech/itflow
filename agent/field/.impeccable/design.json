      "css": ".ds-button-quiet{font-family:\"Segoe UI\",system-ui,sans-serif;font-size:1rem;font-weight:650;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:11px 18px;border:1px solid transparent;border-radius:9px;cursor:pointer;text-decoration:none;touch-action:manipulation;background:transparent;color:var(--ink,#0a2423);padding:8px 11px;}.ds-button-quiet:hover{filter:brightness(.92)}.ds-button-quiet:focus-visible{outline:3px solid var(--focus,#087b6b);outline-offset:3px}.ds-button-quiet:disabled{opacity:.5;cursor:not-allowed}"
